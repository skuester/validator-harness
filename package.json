{
	"name": "validator-harness",
	"version": "0.1.0",
	"private": true,
	"description": "Harness for the multi-version validator pool: warm runner processes with LRU eviction, a byte-bounded artifact cache, and the SQS-to-runner hand-off",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "jest && npm run test:py",
		"test:py": "python3 -m unittest discover -s runner -p 'test_*.py'",
		"crap": "npm run crap:ts && npm run crap:py",
		"crap:ts": "jest --coverage --coverageReporters=json --silent && crap4ts -c coverage/coverage-final.json -s src -t 12 --exclude 'src/demo.ts' 'src/index.ts' -n 12",
		"crap:py": "python3 tools/crap_py.py --max 12",
		"demo": "tsc -p tsconfig.json && node dist/src/demo.js"
	},
	"jest": {
		"preset": "ts-jest",
		"testEnvironment": "node",
		"roots": [
			"<rootDir>/test"
		],
		"testTimeout": 30000,
		"collectCoverageFrom": [
			"src/**/*.ts",
			"!src/demo.ts",
			"!src/index.ts"
		],
		"coverageDirectory": "coverage"
	},
	"devDependencies": {
		"@types/jest": "^29.5.12",
		"@types/node": "^20.11.30",
		"crap4ts": "^1.0.1",
		"jest": "^29.7.0",
		"ts-jest": "^29.1.2",
		"typescript": "^5.4.5"
	}
}

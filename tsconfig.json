{
	"compilerOptions": {
		"target": "ES2022",
		"module": "CommonJS",
		"moduleResolution": "node",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": ".",
		"types": [
			"node",
			"jest"
		]
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts"
	]
}
